---
import Heading from '@/components/astro/content/Heading.astro';
import ContentLayout from '@/layouts/ContentLayout.astro';
import { formatDate } from '@/i18n/format';
import type { Locale } from '@/i18n/config';
import type { LocaleAlternate, PageSeo } from '@/lib/seo/types';

interface Props {
	locale: Locale;
	seo: PageSeo;
	title: string;
	effective?: { label: string; date: Date };
	alternatePath?: string | undefined;
	alternates?: LocaleAlternate[];
}

const { locale, seo, title, effective, alternatePath, alternates } = Astro.props;
---

<ContentLayout {locale} {seo} {alternatePath} {alternates}>
	<header class="mb-8 border-b border-border pb-6">
		<Heading class="wrap-anywhere" size="display">{title}</Heading>
		{
			effective && (
				<p class="mt-3 text-sm text-muted-foreground">
					{effective.label} <time datetime={effective.date.toISOString().slice(0, 10)}>{formatDate(locale, effective.date)}</time>
				</p>
			)
		}
	</header>
	<div class="prose">
		<slot />
	</div>
</ContentLayout>
