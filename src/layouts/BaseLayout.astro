---
import '@/styles/global.css';
import BaseHead from '@/components/core/BaseHead.astro';
import CookieConsent from '@/components/core/CookieConsent.astro';
import { getLocaleDirection, type Locale } from '@/i18n/config';
import { getDictionary } from '@/i18n/helpers';
import type { LocaleAlternate, PageSeo } from '@/lib/seo/types';
import { createThemeInitScript } from '@/scripts/createThemeInitScript';
import { resolveStoredTheme, type ThemeMode } from '@/scripts/theme';
import { PUBLIC_DEFAULT_THEME } from 'astro:env/client';

interface Props {
	locale: Locale;
	seo: PageSeo;
	alternates?: LocaleAlternate[] | undefined;
	jsonLd?: Record<string, unknown> | Record<string, unknown>[] | undefined;
}

const { locale, seo, alternates = [], jsonLd } = Astro.props;
const dictionary = getDictionary(locale);
const direction = getLocaleDirection(locale);
const defaultTheme = resolveStoredTheme(PUBLIC_DEFAULT_THEME as ThemeMode);
const themeInitScript = createThemeInitScript(defaultTheme);
---

<!doctype html>
<html lang={locale} dir={direction} data-theme-mode={defaultTheme}>
	<head>
		<BaseHead locale={locale} seo={seo} alternates={alternates} jsonLd={jsonLd} themeInitScript={themeInitScript} />
	</head>
	<body>
		<a class="absolute start-4 top-[-3rem] z-50 rounded-lg bg-primary px-4 py-3 text-primary-foreground focus:top-4" href="#main">{dictionary.common.skip_to_content}</a>
		<slot />
		<CookieConsent locale={locale} />
	</body>
</html>
