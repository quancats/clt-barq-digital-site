---
import ArticleBody from '@/components/astro/content/ArticleBody.astro';
import Breadcrumbs from '@/components/astro/content/Breadcrumbs.astro';
import ContentLayout from '@/layouts/ContentLayout.astro';
import { createArticlePage } from '@/lib/content/queries/createArticlePage';
import { getArticleSlug, getPublishedArticles } from '@/lib/content/queries/getPublishedArticles';
import { FALLBACK_SITE_URL } from '@/lib/env/resolveSiteUrl';
import { render } from 'astro:content';

export async function getStaticPaths() {
	const articles = await getPublishedArticles('en');
	return articles.map((entry) => ({
		params: { slug: getArticleSlug(entry) },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const locale = 'en' as const;
const site = Astro.site ?? new URL(FALLBACK_SITE_URL);
const page = await createArticlePage({ locale, site, entry });
const { Content } = await render(entry);
---

<ContentLayout locale={locale} seo={page.seo} alternates={page.alternates} alternatePath={page.alternatePath} jsonLd={page.jsonLd}>
	<Breadcrumbs class="mb-6" label={page.dictionary.layout.breadcrumbs_label} items={page.breadcrumbItems} />
	<ArticleBody title={entry.data.title} description={entry.data.description} publishedAt={entry.data.publishedAt}>
		<Content />
	</ArticleBody>
</ContentLayout>
