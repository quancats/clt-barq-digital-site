---
import CorporatePage from './CorporatePage.astro';
import CommercialCatalog from '@/components/astro/commercial/CommercialCatalog.astro';
import CommercialDetail from '@/components/astro/commercial/CommercialDetail.astro';
import { localizePath } from '@/i18n/config';
import { getDictionary } from '@/i18n/helpers';
import WebsiteLayout from '@/layouts/WebsiteLayout.astro';
import { sectionTitles } from '@/lib/content/queries/getSiteRoutes';
import type { SitePageProps } from '@/lib/content/queries/getSitePagePaths';
import { FALLBACK_SITE_URL } from '@/lib/env/resolveSiteUrl';
import { createLocaleAlternates } from '@/lib/seo/createLocaleAlternates';
import { createPageSeo } from '@/lib/seo/createPageSeo';

type Props = SitePageProps;

const page = Astro.props;
const commercial = page.kind === 'catalog' || page.kind === 'commercial' ? page : undefined;
const site = Astro.site ?? new URL(FALLBACK_SITE_URL);
const metadata =
	commercial &&
	(() => {
		const { locale, family, path, alternatePath } = commercial;
		const dictionary = getDictionary(locale);
		const familyTitle = sectionTitles[locale][family];
		const entry = commercial.kind === 'commercial' ? commercial.entry.data : undefined;
		const title = entry?.title ?? familyTitle;
		const other = locale === 'ar' ? 'en' : 'ar';
		return {
			alternates: createLocaleAlternates({ site, pathsByLocale: { [locale]: path, [other]: alternatePath } }),
			seo: createPageSeo({
				title: entry?.seo?.title ?? `${title} | ${dictionary.common.brand}`,
				description: entry?.seo?.description ?? entry?.description ?? title,
				canonicalPath: path,
				image: entry?.media[0]?.path,
			}),
			breadcrumbs: [{ label: dictionary.layout.nav_home, href: localizePath(locale) }, { label: familyTitle, href: localizePath(locale, family) }, { label: title }],
		};
	})();
---

{
	commercial && metadata && (
		<WebsiteLayout locale={commercial.locale} alternatePath={commercial.alternatePath} seo={metadata.seo} alternates={metadata.alternates}>
			{commercial.kind === 'catalog' ? <CommercialCatalog locale={commercial.locale} family={commercial.family} entries={commercial.entries} /> : <CommercialDetail locale={commercial.locale} entry={commercial.entry} breadcrumbs={metadata.breadcrumbs} related={commercial.related} {...(commercial.cta ? { cta: commercial.cta } : {})} {...(commercial.officialLink ? { officialLink: commercial.officialLink } : {})} />}
		</WebsiteLayout>
	)
}
{page.kind !== 'catalog' && page.kind !== 'commercial' && <CorporatePage {...page} />}
