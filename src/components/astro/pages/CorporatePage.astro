---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import CallToAction from '@/components/astro/content/CallToAction.astro';
import Heading from '@/components/astro/content/Heading.astro';
import PageHeading from '@/components/astro/content/PageHeading.astro';
import ProseText from '@/components/astro/content/ProseText.astro';
import Section from '@/components/astro/content/Section.astro';
import Stack from '@/components/astro/content/Stack.astro';
import CorporateMedia from '@/components/astro/pages/CorporateMedia.astro';
import BimProjectPage from '@/components/astro/sections/BimProjectPage.astro';
import WorkOverview from '@/components/astro/sections/WorkOverview.astro';
import AboutPage from '@/components/astro/sections/AboutPage.astro';
import PartnershipsPage from '@/components/astro/sections/PartnershipsPage.astro';
import FaqPage from '@/components/astro/sections/FaqPage.astro';
import ContactPage from '@/components/astro/sections/ContactPage.astro';
import ConsultationPage from '@/components/astro/sections/ConsultationPage.astro';
import BimDemoPage from '@/components/astro/sections/BimDemoPage.astro';
import LeadForm from '@/components/astro/forms/LeadForm.astro';
import { leadPageTypes } from '@/components/astro/forms/leadCopy';
import { localizePath } from '@/i18n/config';
import { getAlternateLocale, getDictionary } from '@/i18n/helpers';
import LegalLayout from '@/layouts/LegalLayout.astro';
import WebsiteLayout from '@/layouts/WebsiteLayout.astro';
import { FALLBACK_SITE_URL } from '@/lib/env/resolveSiteUrl';
import { createLocaleAlternates } from '@/lib/seo/createLocaleAlternates';
import { createPageSeo } from '@/lib/seo/createPageSeo';

type Link = { href: string; label: string };
type LinkKey = 'home' | 'about' | 'projects' | 'contact' | 'consultation' | 'demo' | 'partners' | 'faq' | 'privacy' | 'terms' | 'bim' | 'products' | 'services' | 'solutions' | 'industries' | 'articles';
type ProjectCard = { entry: CollectionEntry<'projects'>; href: string };

type Props = {
	path: string;
	alternatePath?: string | undefined;
	links?: Partial<Record<LinkKey, string>> | undefined;
	related?: Link[] | undefined;
} & ({ kind: 'page'; entry: CollectionEntry<'pages'>; services?: { key: string; label: string }[] } | { kind: 'projects'; entry: CollectionEntry<'pages'>; projects: ProjectCard[] } | { kind: 'project'; entry: CollectionEntry<'projects'> } | { kind: 'legal'; entry: CollectionEntry<'legal'> });

const props = Astro.props;
const { entry, path, alternatePath, links = {}, related = [] } = props;
const { locale, title, description, media, seo: overrides } = entry.data;
const dictionary = getDictionary(locale);
const copy = locale === 'ar' ? { work: 'الأعمال', ownedProduct: 'منتج مملوك', clientProject: 'مشروع عميل', caseStudy: 'دراسة حالة', role: 'الدور', scope: 'النطاق', results: 'النتائج', related: 'محتوى ذو صلة', privacy: 'الخصوصية', effective: 'تاريخ السريان' } : { work: 'Work', ownedProduct: 'Owned product', clientProject: 'Client project', caseStudy: 'Case study', role: 'Role', scope: 'Scope', results: 'Results', related: 'Related content', privacy: 'Privacy', effective: 'Effective date' };
const workKind = { 'owned-product': copy.ownedProduct, 'client-project': copy.clientProject, 'case-study': copy.caseStudy };
const seo = createPageSeo({ title: overrides?.title ?? `${title} | ${dictionary.common.brand}`, description: overrides?.description ?? description, canonicalPath: path, image: media[0]?.path });
const alternates = createLocaleAlternates({ site: Astro.site ?? FALLBACK_SITE_URL, pathsByLocale: { [locale]: path, [getAlternateLocale(locale)]: alternatePath } });
const crumbs = [{ href: localizePath(locale), label: dictionary.layout.nav_home }, ...(props.kind === 'project' && links.projects ? [{ href: links.projects, label: copy.work }] : []), { label: title }];
const details = props.kind === 'project' ? props.entry.data : undefined;
const isBimProject = details?.translationKey === 'bim' && details.kind === 'owned-product';
const page = props.kind === 'page' ? props.entry.data : undefined;
const leadType = page && Object.hasOwn(leadPageTypes, page.translationKey) ? leadPageTypes[page.translationKey as keyof typeof leadPageTypes] : undefined;
const isContact = Boolean(leadType);
const rendered = props.entry.body?.trim() ? await render(props.entry) : undefined;
const Content = rendered?.Content;
const relatedPolicyKey = entry.data.translationKey === 'privacy' ? 'terms' : 'privacy';
const relatedPolicyHref = props.kind === 'legal' ? links[relatedPolicyKey] : undefined;
const relatedPolicy = relatedPolicyHref ? { href: relatedPolicyHref, label: relatedPolicyKey === 'terms' ? (locale === 'ar' ? 'شروط الاستخدام' : 'Terms of use') : locale === 'ar' ? 'سياسة الخصوصية' : 'Privacy policy' } : undefined;
---

{
	props.kind === 'legal' ? (
		<LegalLayout {locale} {seo} {title} {description} {alternatePath} {alternates} breadcrumbs={crumbs} headings={rendered?.headings ?? []} {...(relatedPolicy ? { relatedPolicy } : {})} effective={{ label: copy.effective, date: props.entry.data.effectiveDate }}>
			{Content && <Content />}
		</LegalLayout>
	) : props.kind === 'projects' ? (
		<WebsiteLayout {locale} {seo} {alternatePath} {alternates}>
			<WorkOverview page={props.entry.data} projects={props.projects} breadcrumbs={crumbs} bimHref={links.bim} consultationHref={links.consultation} />
		</WebsiteLayout>
	) : page?.translationKey === 'about' ? (
		<WebsiteLayout {locale} {seo} {alternatePath} {alternates}>
			<AboutPage {page} breadcrumbs={crumbs} {related} bimHref={links.bim} contactHref={links.contact} hasProse={Boolean(Content)}>
				{Content && <Content />}
			</AboutPage>
		</WebsiteLayout>
	) : page?.translationKey === 'partners' ? (
		<WebsiteLayout {locale} {seo} {alternatePath} {alternates}>
			<PartnershipsPage {page} breadcrumbs={crumbs} privacyPath={links.privacy} hasProse={Boolean(Content)}>
				{Content && <Content />}
			</PartnershipsPage>
		</WebsiteLayout>
	) : page?.translationKey === 'faq' ? (
		<WebsiteLayout {locale} {seo} {alternatePath} {alternates}>
			<FaqPage {page} breadcrumbs={crumbs} {links} hasProse={Boolean(Content)}>
				{Content && <Content />}
			</FaqPage>
		</WebsiteLayout>
	) : page?.translationKey === 'contact' ? (
		<WebsiteLayout {locale} {seo} {alternatePath} {alternates}>
			<ContactPage {page} breadcrumbs={crumbs} {links} hasProse={Boolean(Content)}>
				{Content && <Content />}
			</ContactPage>
		</WebsiteLayout>
	) : props.kind === 'page' && props.entry.data.translationKey === 'consultation' ? (
		<WebsiteLayout {locale} {seo} {alternatePath} {alternates}>
			<ConsultationPage page={props.entry.data} breadcrumbs={crumbs} {links} services={props.services ?? []} hasProse={Boolean(Content)}>
				{Content && <Content />}
			</ConsultationPage>
		</WebsiteLayout>
	) : page?.translationKey === 'demo' ? (
		<WebsiteLayout {locale} {seo} {alternatePath} {alternates}>
			<BimDemoPage {page} breadcrumbs={crumbs} {links} hasProse={Boolean(Content)}>
				{Content && <Content />}
			</BimDemoPage>
		</WebsiteLayout>
	) : isBimProject && details ? (
		<WebsiteLayout {locale} {seo} {alternatePath} {alternates}>
			<BimProjectPage project={details} breadcrumbs={crumbs} chapters={rendered?.headings.filter(({ depth }) => depth === 2) ?? []} productHref={links.bim} demoHref={links.demo}>
				{Content && <Content />}
			</BimProjectPage>
		</WebsiteLayout>
	) : (
		<WebsiteLayout {locale} {seo} {alternatePath} {alternates}>
			<PageHeading id="corporate-title" {title} {description} breadcrumbs={crumbs} breadcrumbLabel={dictionary.layout.breadcrumbs_label} eyebrow={details ? workKind[details.kind] : undefined} />
			{isContact && (
				<Section>
					<Stack spacing="relaxed">
						{!Content && page?.contactLinks?.length ? (
							<ul class="flex flex-wrap gap-4">
								{page.contactLinks.map((link) => (
									<li>
										<a class="font-semibold wrap-anywhere text-primary-link underline" href={link.href} data-analytics-action="contact_action">
											{link.label}
										</a>
									</li>
								))}
							</ul>
						) : null}
						{links.privacy && (
							<a class="w-fit text-primary-link underline" href={links.privacy}>
								{copy.privacy}
							</a>
						)}
						{leadType && props.kind === 'page' && <LeadForm {locale} type={leadType} {...(links.privacy ? { privacyPath: links.privacy } : {})} services={props.services ?? []} />}
					</Stack>
				</Section>
			)}
			{Content && page && (
				<Section class={isContact ? 'pt-0' : ''}>
					<div class="prose">
						<Content />
					</div>
				</Section>
			)}
			{!Content &&
				page?.sections.map((section, index) => (
					<Section labelledBy={`content-${index}`} tone={index % 2 === 0 ? 'muted' : 'plain'}>
						<Stack>
							<Heading level={2} id={`content-${index}`} class="text-2xl wrap-anywhere">
								{section.title}
							</Heading>
							<ProseText class="whitespace-pre-line">{section.body}</ProseText>
						</Stack>
					</Section>
				))}
			{details && (
				<Section tone="muted">
					<Stack spacing="relaxed">
						<Heading level={2} class="text-xl">
							{copy.role}
						</Heading>
						<ProseText>{details.role}</ProseText>
						<Heading level={2} class="text-xl">
							{copy.scope}
						</Heading>
						<ProseText>{details.scope}</ProseText>
						{details.results.length > 0 && (
							<Heading level={2} class="text-xl">
								{copy.results}
							</Heading>
						)}
						{details.results.length > 0 && (
							<ul class="list-inside list-disc">
								{details.results.map((result) => (
									<li>{result}</li>
								))}
							</ul>
						)}
						{Content && (
							<ProseText variant="rich">
								<Content />
							</ProseText>
						)}
					</Stack>
				</Section>
			)}
			{media.length > 0 && (
				<Section>
					<div class="grid gap-grid-gutter md:grid-cols-2">
						{media.map((image) => (
							<CorporateMedia {image} />
						))}
					</div>
				</Section>
			)}
			{related.length > 0 && (
				<Section labelledBy="related-heading">
					<Stack>
						<Heading level={2} id="related-heading" class="text-xl">
							{copy.related}
						</Heading>
						<ul class="flex flex-wrap gap-4">
							{related.map((link) => (
								<li>
									<CallToAction {...link} variant="outline" {...(link.href === links.consultation ? { analyticsAction: 'consultation_cta' as const } : link.href === links.demo ? { analyticsAction: 'demo_cta' as const } : link.href === links.partners ? { analyticsAction: 'partnership_cta' as const } : {})} />
								</li>
							))}
						</ul>
					</Stack>
				</Section>
			)}
		</WebsiteLayout>
	)
}
