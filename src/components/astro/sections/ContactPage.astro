---
import { Icon } from 'astro-icon/components';
import type { CollectionEntry } from 'astro:content';
import Heading from '@/components/astro/content/Heading.astro';
import PageHeading from '@/components/astro/content/PageHeading.astro';
import LeadForm from '@/components/astro/forms/LeadForm.astro';
import CorporateMedia from '@/components/astro/pages/CorporateMedia.astro';
import Container from '@/components/layout/Container.astro';
import { getDictionary } from '@/i18n/helpers';

interface Props {
	page: CollectionEntry<'pages'>['data'];
	breadcrumbs: { label: string; href?: string }[];
	links: Partial<Record<'consultation' | 'demo' | 'partners' | 'privacy', string>>;
	hasProse: boolean;
}

const { page, breadcrumbs, links, hasProse } = Astro.props;
const { locale, sections, media, contactLinks = [] } = page;
const copy = locale === 'ar' ? { routes: 'اختر طريقة التواصل', direct: 'تواصل مباشر', email: 'البريد الإلكتروني', phone: 'الهاتف', country: 'المملكة العربية السعودية', inquiry: 'أرسل استفسارك', privacy: 'إشعار الخصوصية' } : { routes: 'Choose how to connect', direct: 'Contact us directly', email: 'Email', phone: 'Phone', country: 'Saudi Arabia', inquiry: 'Send your inquiry', privacy: 'Privacy notice' };
const routes = (
	[
		{ key: 'consultation', icon: 'lucide:messages-square', analytics: 'consultation_cta' },
		{ key: 'demo', icon: 'lucide:monitor-play', analytics: 'demo_cta' },
		{ key: 'partners', icon: 'lucide:handshake', analytics: 'partnership_cta' },
	] as const
).flatMap(({ key, icon, analytics }) => {
	const section = sections.find((item) => item.key === key);
	const href = links[key];
	return section && href ? [{ ...section, href, icon, analytics }] : [];
});
const hours = sections.find(({ key }) => key === 'hours');
const inquiry = sections.find(({ key }) => key === 'inquiry');
const showDirect = contactLinks.length > 0 || Boolean(hours);
---

<div class="contact-page">
	<PageHeading id="contact-page-title" title={page.title} description={page.description} {breadcrumbs} breadcrumbLabel={getDictionary(locale).layout.breadcrumbs_label} />

	{
		routes.length > 0 && (
			<section class="py-section" aria-labelledby="contact-routes">
				<Container>
					<Heading level={2} id="contact-routes" class="contact-heading">
						{copy.routes}
					</Heading>
					<ul class="contact-routes" role="list">
						{routes.map(({ title, body, href, icon, analytics }) => (
							<li>
								<a {href} data-analytics-action={analytics} class="contact-route">
									<span class="contact-icon">
										<Icon name={icon} size={22} aria-hidden="true" />
									</span>
									<div>
										<Heading level={3} class="contact-route-title">
											{title}
										</Heading>
										<p>{body}</p>
									</div>
									<Icon name="lucide:arrow-right" size={19} class="route-arrow rtl:rotate-180" aria-hidden="true" />
								</a>
							</li>
						))}
					</ul>
				</Container>
			</section>
		)
	}

	<section class="contact-channels section-wash py-section" aria-label={copy.inquiry}>
		<Container>
			<div class:list={['channels-layout', { 'has-direct': showDirect }]}>
				{
					showDirect && (
						<div class="direct-panel">
							<Heading level={2} class="contact-heading">
								{copy.direct}
							</Heading>
							{contactLinks.length > 0 && (
								<ul class="direct-links" role="list">
									{contactLinks.map(({ label, href }) => {
										const email = href.startsWith('mailto:');
										return (
											<li>
												<a {href} data-analytics-action="contact_action">
													<span class="contact-icon">
														<Icon name={email ? 'lucide:mail' : 'lucide:phone'} size={19} aria-hidden="true" />
													</span>
													<span>
														<span class="direct-label">{email ? copy.email : copy.phone}</span>
														<bdi dir="ltr">{label}</bdi>
													</span>
												</a>
											</li>
										);
									})}
								</ul>
							)}
							{hours && (
								<div class="business-hours">
									<Icon name="lucide:clock" size={19} aria-hidden="true" />
									<div>
										<Heading level={3} class="contact-route-title">
											{hours.title}
										</Heading>
										<p>{hours.body}</p>
										<p>{copy.country}</p>
									</div>
								</div>
							)}
						</div>
					)
				}
				<div class="inquiry-panel">
					<Heading level={2} class="contact-heading">{inquiry?.title ?? copy.inquiry}</Heading>
					{inquiry && <p>{inquiry.body}</p>}
					{
						links.privacy && (
							<a class="contact-privacy" href={links.privacy}>
								{copy.privacy}
							</a>
						)
					}
					<LeadForm {locale} type="general" services={[]} {...links.privacy ? { privacyPath: links.privacy } : {}} />
				</div>
			</div>
		</Container>
	</section>

	{
		(hasProse || media.length > 0) && (
			<Container class="py-section">
				{hasProse && (
					<div class="prose">
						<slot />
					</div>
				)}
				{media.length > 0 && (
					<div class="grid gap-grid-gutter md:grid-cols-2">
						{media.map((image) => (
							<CorporateMedia {image} />
						))}
					</div>
				)}
			</Container>
		)
	}
</div>

<style>
	.contact-page {
		--contact-line: var(--section-rule);
		--contact-tint: var(--brand-section-tint);
	}
	.contact-page :global(.contact-heading) {
		font-size: clamp(1.45rem, 1.1rem + 1.3vi, 2.25rem);
		line-height: 1.25;
	}
	.contact-page :global(.contact-route-title) {
		font-size: clamp(1.025rem, 0.98rem + 0.32vi, 1.24rem);
		line-height: 1.3;
	}
	.contact-routes {
		display: grid;
		gap: 0.75rem;
		margin-block-start: clamp(1rem, 2.5vi, 1.7rem);
	}
	.contact-route {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		align-items: start;
		gap: clamp(0.65rem, 1.6vi, 1rem);
		block-size: 100%;
		padding: clamp(0.9rem, 2.2vi, 1.4rem);
		border: 1px solid var(--contact-line);
		border-radius: 0.8rem;
		background: var(--card);
	}
	.contact-route:is(:hover, :focus-visible),
	.direct-links a:is(:hover, :focus-visible) {
		border-color: var(--primary-link);
		background: var(--contact-tint);
	}
	.contact-icon {
		display: grid;
		flex: none;
		place-items: center;
		inline-size: 2.55rem;
		block-size: 2.55rem;
		border: 1px solid var(--contact-line);
		border-radius: 0.55rem;
		background: var(--contact-tint);
		color: var(--primary-link);
	}
	.route-arrow {
		align-self: center;
		color: var(--primary-link);
	}
	.contact-route p,
	.business-hours p,
	.inquiry-panel > p {
		margin-block-start: 0.4rem;
		color: var(--muted-foreground);
		line-height: 1.65;
	}
	.contact-channels {
		border-block-start: 1px solid var(--contact-line);
	}
	.channels-layout {
		display: grid;
		align-items: stretch;
		gap: clamp(1rem, 3vi, 2rem);
	}
	.direct-panel,
	.inquiry-panel {
		min-inline-size: 0;
		padding: clamp(1.1rem, 3vi, 2.25rem);
		border: 1px solid var(--contact-line);
		border-radius: 0.85rem;
		background: var(--card);
	}
	.direct-panel {
		border-block-start: 0.24rem solid var(--primary-link);
	}
	.direct-links {
		display: grid;
		gap: 0.45rem;
		margin-block-start: 1rem;
	}
	.direct-links a {
		display: flex;
		align-items: center;
		gap: 0.8rem;
		padding: 0.55rem;
		border: 1px solid transparent;
		border-radius: 0.55rem;
		overflow-wrap: anywhere;
	}
	.direct-label {
		display: block;
		margin-block-end: 0.1rem;
		color: var(--muted-foreground);
		font-size: 0.875rem;
	}
	.direct-links bdi {
		color: var(--primary-link);
		font-weight: 650;
	}
	.business-hours {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		align-items: baseline;
		gap: 0.65rem;
		margin-block-start: 1rem;
		padding-block-start: 1rem;
		border-block-start: 1px solid var(--contact-line);
	}
	.business-hours svg {
		align-self: start;
		color: var(--primary-link);
	}
	.inquiry-panel > :global(form),
	.inquiry-panel > :global(p:last-child) {
		margin-block-start: 1.2rem;
	}
	.contact-privacy {
		display: inline-block;
		margin-block-start: 0.65rem;
		color: var(--primary-link);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
	@media (min-width: 52rem) {
		.contact-routes {
			grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
		}
		.channels-layout.has-direct {
			grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr);
		}
	}
</style>
