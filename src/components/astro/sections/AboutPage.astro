---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import type { CollectionEntry } from 'astro:content';
import architecture from '@/assets/images/enterprise-architecture-about.png';
import type { BreadcrumbItem } from '@/components/astro/content/Breadcrumbs.astro';
import CallToAction from '@/components/astro/content/CallToAction.astro';
import Heading from '@/components/astro/content/Heading.astro';
import PageHeading from '@/components/astro/content/PageHeading.astro';
import CorporateMedia from '@/components/astro/pages/CorporateMedia.astro';
import Container from '@/components/layout/Container.astro';
import BimLogo from './BimLogo.astro';

interface Props {
	page: CollectionEntry<'pages'>['data'];
	breadcrumbs: BreadcrumbItem[];
	related: readonly { label: string; href: string }[];
	bimHref: string | undefined;
	contactHref: string | undefined;
	hasProse: boolean;
}

const { page, breadcrumbs, related, bimHref, contactHref, hasProse } = Astro.props;
const { locale, title, description, sections, media, profile } = page;
const copy = locale === 'ar' ? { breadcrumbs: 'مسار التنقّل', values: 'قيمنا', bim: 'استكشف BIM', explore: 'استكشف ما نقدمه', contact: 'تواصل معنا', closing: 'لنتحدث عن مؤسستك' } : { breadcrumbs: 'Breadcrumb', values: 'Our values', bim: 'Explore BIM', explore: 'Explore what we do', contact: 'Contact us', closing: 'Let’s talk about your organization' };
const section = (key: string) => sections.find((item) => item.key === key);
const identity = section('identity');
const direction = sections.filter(({ key }) => key === 'vision' || key === 'mission');
const values = sections.filter(({ key }) => key.startsWith('value-'));
const process = section('process');
const steps =
	process?.body
		.split('\n')
		.map((line) => line.trim())
		.filter(Boolean) ?? [];
const products = section('products');
const contact = section('contact');
const supplementary = sections.filter(({ key }) => !['identity', 'vision', 'mission', 'process', 'products', 'contact'].includes(key) && !key.startsWith('value-'));
const valueIcons: Record<string, string> = {
	'value-trust': 'lucide:handshake',
	'value-security': 'lucide:shield-check',
	'value-quality': 'lucide:clipboard-check',
	'value-innovation': 'lucide:lightbulb',
	'value-responsibility': 'lucide:scale',
};
const number = new Intl.NumberFormat(locale, { useGrouping: false });
---

<div class="about-page">
	<PageHeading id="about-title" {title} {description} {breadcrumbs} breadcrumbLabel={copy.breadcrumbs} />

	{
		identity && (
			<section class="about-identity py-section" aria-labelledby="about-identity-title">
				<Container>
					<div class="identity-layout">
						<div>
							<Heading level={2} id="about-identity-title" class="about-section-title">
								{identity.title}
							</Heading>
							<p>{identity.body}</p>
							{profile && <CallToAction href={profile.path} label={profile.label} variant="outline" />}
						</div>
						<div class="identity-visual">{media[0] ? <CorporateMedia image={media[0]} /> : <Image src={architecture} alt="" widths={[400, 640, 900, 1200]} sizes="(min-width: 80rem) 570px, (min-width: 56rem) 47vw, 100vw" format="webp" quality={80} />}</div>
					</div>
				</Container>
			</section>
		)
	}

	{
		direction.length > 0 && (
			<div class="about-direction section-divider section-wash py-section">
				<Container>
					<div class="direction-layout">
						{direction.map(({ key, title, body }) => (
							<section class:list={['direction-panel', key === 'vision' && 'direction-vision']} aria-labelledby={`about-${key}-title`}>
								<Icon name={key === 'vision' ? 'lucide:compass' : 'lucide:target'} size={25} aria-hidden="true" />
								<Heading level={2} id={`about-${key}-title`} class="about-section-title">
									{title}
								</Heading>
								<p>{body}</p>
							</section>
						))}
					</div>
				</Container>
			</div>
		)
	}

	{
		values.length > 0 && (
			<section class="about-values py-section" aria-labelledby="about-values-title">
				<Container>
					<div class="values-layout">
						<Heading level={2} id="about-values-title" class="about-section-title">
							{copy.values}
						</Heading>
						<ul class="values-index" role="list">
							{values.map(({ key, title, body }) => (
								<li>
									<span class="value-icon">
										<Icon name={valueIcons[key] ?? 'lucide:check'} size={20} aria-hidden="true" />
									</span>
									<Heading level={3} class="value-title">
										{title}
									</Heading>
									<p>{body}</p>
								</li>
							))}
						</ul>
					</div>
				</Container>
			</section>
		)
	}

	{
		products && (
			<section class="about-product py-section" aria-labelledby="about-product-title">
				<Container>
					<div class="product-panel">
						<div class="product-brand">
							<BimLogo />
						</div>
						<div class="product-copy">
							<Heading level={2} id="about-product-title" class="about-section-title">
								{products.title}
							</Heading>
							<p>{products.body}</p>
							{bimHref && <CallToAction href={bimHref} label={copy.bim} variant="outline" />}
						</div>
					</div>
				</Container>
			</section>
		)
	}

	{
		process && steps.length > 0 && (
			<section class="about-process py-section" aria-labelledby="about-process-title">
				<Container>
					<Heading level={2} id="about-process-title" class="about-section-title">
						{process.title}
					</Heading>
					<ol class="process-list" role="list">
						{steps.map((step, index) => (
							<li>
								<span class="step-number" aria-hidden="true">
									{number.format(index + 1)}
								</span>
								<span>{step}</span>
							</li>
						))}
					</ol>
				</Container>
			</section>
		)
	}

	{
		(hasProse || supplementary.length > 0 || media.length > (identity ? 1 : 0) || (profile && !identity)) && (
			<Container class="section-divider py-section">
				<div class="about-supplementary">
					{hasProse && (
						<div class="prose">
							<slot />
						</div>
					)}
					{supplementary.map(({ key, title, body }) => (
						<section aria-labelledby={`about-extra-${key}`}>
							<Heading level={2} id={`about-extra-${key}`} class="about-section-title">
								{title}
							</Heading>
							<p>{body}</p>
						</section>
					))}
					{media.slice(identity ? 1 : 0).map((image) => (
						<CorporateMedia {image} />
					))}
					{profile && !identity && <CallToAction href={profile.path} label={profile.label} variant="outline" />}
				</div>
			</Container>
		)
	}

	{
		related.length > 0 && (
			<section class="about-related section-wash py-section" aria-labelledby="about-explore-title">
				<Container>
					<div class="related-panel">
						<Heading level={2} id="about-explore-title" class="about-section-title">
							{copy.explore}
						</Heading>
						<ul class="related-links" role="list">
							{related.map(({ href, label }) => (
								<li>
									<CallToAction {href} {label} variant="outline" />
								</li>
							))}
						</ul>
					</div>
				</Container>
			</section>
		)
	}

	{
		contactHref && (
			<section class="about-contact py-section" aria-labelledby="about-contact-title">
				<Container>
					<div class="contact-panel">
						<div>
							<Heading level={2} id="about-contact-title" class="about-section-title">
								{contact?.title ?? copy.closing}
							</Heading>
							{contact && <p>{contact.body}</p>}
						</div>
						<CallToAction href={contactHref} label={copy.contact} analyticsAction="contact_action" />
					</div>
				</Container>
			</section>
		)
	}
</div>

<style>
	.about-page {
		--about-line: var(--section-rule);
		--about-tint: var(--brand-section-tint);
		--about-grid: color-mix(in oklab, var(--primary-link) 12%, transparent);
	}
	.about-page :global(.about-section-title) {
		font-size: clamp(1.45rem, 1.1rem + 1.45vi, 2.35rem);
		line-height: 1.25;
		text-wrap: balance;
	}
	.identity-layout,
	.values-layout {
		display: grid;
		gap: clamp(1.25rem, 4vi, 3rem);
	}
	.identity-layout {
		align-items: center;
	}
	.identity-visual {
		display: grid;
		place-items: center;
		min-inline-size: 0;
		border-radius: 1.1rem;
		background: radial-gradient(ellipse at center, var(--about-tint), transparent 75%);
	}
	.identity-visual :global(img) {
		display: block;
		inline-size: 100%;
		block-size: auto;
	}
	.identity-layout p,
	.direction-panel p,
	.product-copy p,
	.contact-panel p,
	.about-supplementary p {
		max-inline-size: 66ch;
		margin-block-start: 0.65rem;
		color: var(--muted-foreground);
		line-height: 1.75;
	}
	.identity-layout > div > :global(a),
	.product-copy > :global(a) {
		margin-block-start: 1rem;
	}
	.direction-layout {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 1px;
		overflow: clip;
		border: 1px solid var(--about-line);
		border-radius: 1rem;
		background: var(--about-line);
	}
	.direction-panel {
		padding: clamp(1.2rem, 3.3vi, 2.4rem);
		background: var(--about-tint);
	}
	.direction-panel :global(svg) {
		margin-block-end: 0.65rem;
		color: var(--primary-link);
	}
	.direction-vision {
		background: radial-gradient(ellipse at top, var(--brand-panel-glow), var(--brand-panel-surface) 82%);
		color: var(--brand-on-navy);
	}
	.direction-vision :global(.about-section-title) {
		color: inherit;
	}
	.direction-vision :global(svg) {
		color: var(--brand-on-panel);
	}
	.direction-vision p {
		color: var(--brand-panel-copy);
	}
	.values-index {
		border-block-start: 1px solid var(--about-line);
	}
	.values-index li {
		display: grid;
		align-items: center;
		grid-template-columns: auto minmax(0, 1fr);
		gap: 0.35rem 0.7rem;
		padding-block: 0.75rem;
		border-block-end: 1px solid var(--about-line);
	}
	.value-icon {
		display: grid;
		place-items: center;
		inline-size: 2.45rem;
		block-size: 2.45rem;
		border-radius: 0.55rem;
		background: var(--about-tint);
		color: var(--primary-link);
	}
	.values-index :global(.value-title) {
		font-size: 1.08rem;
	}
	.values-index p {
		grid-column: 2;
		color: var(--muted-foreground);
		line-height: 1.65;
	}
	.product-panel {
		display: grid;
		align-items: center;
		gap: 1px;
		overflow: clip;
		border: 1px solid var(--about-line);
		border-radius: 1rem;
		background: var(--about-line);
	}
	.product-brand {
		isolation: isolate;
		display: grid;
		block-size: 100%;
		min-block-size: 8rem;
		padding: 1.25rem;
		place-items: center;
		background: repeating-linear-gradient(90deg, transparent 0 23px, var(--about-grid) 23px 24px), repeating-linear-gradient(0deg, transparent 0 23px, var(--about-grid) 23px 24px), var(--about-tint);
	}
	.product-copy {
		block-size: 100%;
		padding: clamp(1.2rem, 3vi, 2.15rem);
		background: var(--brand-frame-surface);
	}
	.process-list {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 1px;
		overflow: clip;
		margin-block-start: 1.1rem;
		border: 1px solid var(--about-line);
		border-radius: 0.85rem;
		background: var(--about-line);
	}
	.process-list li {
		display: flex;
		align-items: start;
		gap: 0.65rem;
		padding: 1rem;
		background: var(--brand-frame-surface);
		line-height: 1.6;
	}
	.step-number {
		display: grid;
		place-items: center;
		inline-size: 2rem;
		block-size: 2rem;
		flex: none;
		border-radius: 50%;
		background: var(--about-tint);
		color: var(--primary-link);
		font-weight: 700;
	}
	.about-supplementary {
		display: grid;
		gap: 1rem;
	}
	.about-supplementary p {
		white-space: pre-line;
	}
	.related-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
		margin-block-start: 0.9rem;
	}
	.contact-panel {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.9rem 1.5rem;
		padding: clamp(1rem, 3.5vi, 2.35rem);
		border: 1px solid var(--about-line);
		border-radius: 0.9rem;
		background: var(--about-tint);
	}
	@media (min-width: 48rem) {
		.direction-layout {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
		.direction-panel:only-child {
			grid-column: 1 / -1;
		}
		.values-index li {
			grid-template-columns: auto minmax(6.5rem, 0.38fr) minmax(0, 1.35fr);
		}
		.values-index p {
			grid-column: auto;
		}
		.product-panel {
			grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.65fr);
		}
	}
	@media (min-width: 56rem) {
		.identity-layout {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
		}
		.values-layout {
			grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.9fr);
		}
	}
	@media (min-width: 62rem) {
		.process-list {
			grid-template-columns: repeat(5, minmax(0, 1fr));
		}
		.process-list li {
			flex-direction: column;
		}
	}
</style>
