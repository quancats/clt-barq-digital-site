---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import type { CollectionEntry } from 'astro:content';
import adminAr from '@/assets/images/projects/bim-previews/admin-ar.jpg';
import adminEn from '@/assets/images/projects/bim-previews/admin-en.jpg';
import mobileAr from '@/assets/images/projects/bim-previews/mobile-ar.jpg';
import mobileEn from '@/assets/images/projects/bim-previews/mobile-en.jpg';
import PageHeading from '@/components/astro/content/PageHeading.astro';
import CallToAction from '@/components/astro/content/CallToAction.astro';
import Heading from '@/components/astro/content/Heading.astro';
import Container from '@/components/layout/Container.astro';
import type { Locale } from '@/i18n/config';
import BimLogo from './BimLogo.astro';

interface Props {
	locale: Locale;
	entries: { title: string; description: string; href: string }[];
	overview: CollectionEntry<'pages'>['data'] | undefined;
	bim:
		| {
				product: CollectionEntry<'products'>['data'];
				href: string;
				storyHref: string | undefined;
				demoHref: string | undefined;
		  }
		| undefined;
	breadcrumbs: { label: string; href?: string }[];
}

const { locale, entries, overview, bim, breadcrumbs } = Astro.props;
const ar = locale === 'ar';
const copy = ar ? { label: 'المنتجات', breadcrumbs: 'مسار التنقل', featured: 'منتجنا الرئيسي', product: 'استكشف BIM', story: 'اقرأ قصة تطوير BIM', more: 'منتجات أخرى', caption: 'معاينة تطبيق BIM ولوحة الإدارة ببيانات تجريبية' } : { label: 'Products', breadcrumbs: 'Breadcrumb', featured: 'Our flagship product', product: 'Explore BIM', story: 'Read the BIM development story', more: 'Other products', caption: 'BIM app and admin console previews with sample data' };
const featured = bim?.product;
const other = entries.filter(({ href }) => href !== bim?.href);
const philosophy = overview?.sections.find(({ key }) => key === 'philosophy');
const demo = overview?.sections.find(({ key }) => key === 'demo');
const icons: Record<string, string> = { messaging: 'lucide:messages-square', 'file-sharing': 'lucide:paperclip', calls: 'lucide:video', 'admin-console': 'lucide:panels-top-left' };
---

<div class="products-overview">
	<PageHeading id="catalog-heading" title={overview?.title ?? copy.label} description={overview?.description} {breadcrumbs} breadcrumbLabel={copy.breadcrumbs} />

	{
		bim && featured && (
			<section class="product-spotlight py-section" aria-labelledby="featured-bim">
				<Container>
					<div class="featured-panel">
						<div class="featured-copy">
							<p class="featured-label">{copy.featured}</p>
							<div class="featured-logo">
								<BimLogo priority />
							</div>
							<Heading level={2} id="featured-bim" class="catalog-title">
								{featured.title}
							</Heading>
							<p class="featured-description">{featured.description}</p>
							<div class="catalog-actions">
								<CallToAction href={bim.href} label={copy.product} />
								{bim.storyHref && <CallToAction href={bim.storyHref} label={copy.story} variant="outline" />}
							</div>
						</div>
						<figure class="featured-preview">
							<div class="preview-composition">
								<Image src={ar ? adminAr : adminEn} width={700} alt="" class="catalog-admin" />
								<Image src={ar ? mobileAr : mobileEn} width={260} alt="" class="catalog-mobile" />
							</div>
							<figcaption>{copy.caption}</figcaption>
						</figure>
						<ul class="capability-list" role="list">
							{featured.features.map(({ key, title }) => (
								<li>
									<Icon name={icons[key] ?? 'lucide:check'} size={20} class="shrink-0" aria-hidden="true" />
									<span>{title}</span>
								</li>
							))}
						</ul>
					</div>
				</Container>
			</section>
		)
	}

	{
		other.length > 0 && (
			<section class="py-section" aria-labelledby={bim ? 'other-products' : 'catalog-heading'}>
				<Container>
					{bim && (
						<Heading level={2} id="other-products" class="catalog-title">
							{copy.more}
						</Heading>
					)}
					<ul class="other-products" role="list">
						{other.map(({ title, description, href }) => (
							<li>
								<Heading level={bim ? 3 : 2} class="text-lg">
									<a {href}>{title}</a>
								</Heading>
								<p>{description}</p>
							</li>
						))}
					</ul>
				</Container>
			</section>
		)
	}

	{
		(philosophy || (demo && bim?.demoHref)) && (
			<div class="catalog-footer py-section">
				<Container>
					<div class="catalog-footer-layout">
						{philosophy && (
							<section aria-labelledby="product-philosophy">
								<Heading level={2} id="product-philosophy" class="catalog-title">
									{philosophy.title}
								</Heading>
								<p>{philosophy.body}</p>
							</section>
						)}
						{demo && bim?.demoHref && (
							<section class="catalog-demo" aria-labelledby="products-demo">
								<Heading level={2} id="products-demo" class="text-xl">
									{demo.title}
								</Heading>
								<CallToAction href={bim.demoHref} label={demo.body} variant="outline" analyticsAction="demo_cta" />
							</section>
						)}
					</div>
				</Container>
			</div>
		)
	}
</div>

<style>
	.products-overview {
		--catalog-accent: var(--primary-link);
		--catalog-tint: var(--brand-section-tint);
		--catalog-rule: var(--section-rule);
	}
	.featured-description,
	.catalog-footer p,
	.other-products p {
		max-inline-size: 66ch;
		margin-block-start: 0.75rem;
		color: var(--muted-foreground);
		line-height: 1.7;
	}
	.featured-panel {
		display: grid;
		gap: 1px;
		overflow: clip;
		border: 1px solid var(--catalog-rule);
		border-radius: 1.25rem;
		background: var(--catalog-rule);
	}
	.featured-copy {
		padding: clamp(1.2rem, 4vi, 3rem);
		background: var(--brand-frame-surface);
	}
	.featured-label {
		color: var(--catalog-accent);
		font-size: 0.875rem;
		font-weight: 700;
	}
	.featured-logo {
		margin-block: 0.8rem 1rem;
		inline-size: min(100%, 13.5rem);
	}
	.products-overview :global(.catalog-title) {
		font-size: clamp(1.45rem, 1.08rem + 1.65vi, 2.5rem);
		line-height: 1.22;
		text-wrap: balance;
	}
	.catalog-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
		margin-block-start: 1.25rem;
	}
	.featured-preview {
		display: grid;
		align-content: center;
		justify-items: center;
		gap: 1rem;
		margin: 0;
		padding: clamp(1.1rem, 3vi, 2.15rem);
		background: radial-gradient(ellipse at center, var(--brand-panel-glow), var(--brand-panel-surface) 82%);
	}
	.preview-composition {
		display: grid;
		grid-template-columns: repeat(10, minmax(0, 1fr));
		align-items: center;
		inline-size: min(100%, 34rem);
	}
	.preview-composition :global(img) {
		grid-row: 1;
		inline-size: 100%;
		block-size: auto;
		border-radius: 0.65rem;
		box-shadow: 0 0.7rem 1.5rem var(--brand-panel-shadow);
	}
	.preview-composition :global(.catalog-admin) {
		grid-column: 1 / span 8;
	}
	.preview-composition :global(.catalog-mobile) {
		grid-column: 8 / span 3;
		max-inline-size: 8.5rem;
		justify-self: end;
	}
	.featured-preview figcaption {
		color: var(--brand-panel-copy);
		font-size: 0.82rem;
		text-align: center;
	}
	.capability-list {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1px;
	}
	.capability-list li {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		min-inline-size: 0;
		padding: 0.95rem;
		background: var(--catalog-tint);
		font-weight: 600;
		overflow-wrap: anywhere;
	}
	.capability-list :global(svg),
	.other-products a {
		color: var(--catalog-accent);
	}
	.other-products {
		display: grid;
		gap: 0.85rem;
		margin-block-start: 1rem;
	}
	.other-products li {
		padding: 1rem;
		border: 1px solid var(--catalog-rule);
		border-radius: 0.7rem;
	}
	.other-products a:hover {
		text-decoration: underline;
	}
	.catalog-footer-layout {
		display: grid;
		align-items: start;
		gap: clamp(1.4rem, 4vi, 3rem);
	}
	.catalog-demo {
		display: grid;
		justify-items: start;
		gap: 0.9rem;
		padding: clamp(1rem, 3vi, 1.75rem);
		border: 1px solid var(--catalog-rule);
		border-radius: 0.8rem;
		background: var(--catalog-tint);
	}
	@media (min-width: 54rem) {
		.featured-panel {
			grid-template-columns: minmax(0, 1.08fr) minmax(0, 1fr);
		}
		.capability-list {
			grid-column: 1 / -1;
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
		.catalog-footer-layout {
			grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.8fr);
		}
		.other-products {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
</style>
