---
import { Icon } from 'astro-icon/components';
import Card from '@/components/astro/content/Card.astro';
import Heading from '@/components/astro/content/Heading.astro';
import type { Locale } from '@/i18n/config';
import { getDictionary } from '@/i18n/helpers';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const copy = getDictionary(locale).components.icons_demo;

const uiIcons = [
	{ name: 'lucide:search', label: copy.search },
	{ name: 'lucide:mail', label: copy.mail },
	{ name: 'lucide:settings', label: copy.settings },
	{ name: 'lucide:info', label: copy.info },
] as const;

const brandIcons = [
	{ name: 'simple-icons:astro', label: 'Astro' },
	{ name: 'simple-icons:github', label: 'GitHub' },
	{ name: 'simple-icons:nodedotjs', label: 'Node.js' },
] as const;
---

<section aria-labelledby="astro-icons-demo-title" class="space-y-4">
	<header class="space-y-2">
		<Heading id="astro-icons-demo-title" level={2} class="text-2xl">
			{copy.title}
		</Heading>
		<p class="max-w-3xl text-muted-foreground">{copy.description}</p>
	</header>

	<div class="grid gap-4 md:grid-cols-2">
		<Card class="space-y-3">
			<Heading level={3} class="text-base">
				{copy.ui_heading}
			</Heading>
			<p class="text-sm text-muted-foreground">{copy.ui_body}</p>
			<ul class="flex flex-wrap gap-3" role="list">
				{
					uiIcons.map((item) => (
						<li class="inline-flex items-center gap-2 rounded-md border border-border bg-background px-3 py-2 text-sm">
							<Icon name={item.name} size={18} aria-hidden="true" />
							<span>{item.label}</span>
							<code class="text-xs text-muted-foreground">{item.name}</code>
						</li>
					))
				}
			</ul>
		</Card>

		<Card class="space-y-3">
			<Heading level={3} class="text-base">
				{copy.brand_heading}
			</Heading>
			<p class="text-sm text-muted-foreground">{copy.brand_body}</p>
			<ul class="flex flex-wrap gap-3" role="list">
				{
					brandIcons.map((item) => (
						<li class="inline-flex items-center gap-2 rounded-md border border-border bg-background px-3 py-2 text-sm">
							<Icon name={item.name} size={18} title={item.label} role="img" aria-label={item.label} />
							<span>{item.label}</span>
							<code class="text-xs text-muted-foreground">{item.name}</code>
						</li>
					))
				}
			</ul>
		</Card>
	</div>
</section>
