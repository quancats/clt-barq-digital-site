---
import { Icon } from 'astro-icon/components';
import Heading from '@/components/astro/content/Heading.astro';
import Container from '@/components/layout/Container.astro';
import type { Locale } from '@/i18n/config';

const disciplines = [
	{ key: 'cybersecurity', icon: 'lucide:shield-check', ar: 'استكشف الأمن السيبراني', en: 'Explore cybersecurity' },
	{ key: 'solutions', icon: 'lucide:network', ar: 'استكشف الحلول الرقمية', en: 'Explore digital solutions' },
	{ key: 'products', icon: 'lucide:layers', ar: 'استكشف المنتجات المؤسسية', en: 'Explore enterprise products' },
] as const;

interface Props {
	locale: Locale;
	sections: { key: string; title: string; body: string }[];
	links: Record<(typeof disciplines)[number]['key'], string | undefined>;
}

const { locale, sections, links } = Astro.props;
const copy = locale === 'ar' ? { label: 'قدراتنا', title: 'ثلاثة مجالات، رؤية واحدة' } : { label: 'Our capabilities', title: 'Three disciplines, one vision' };
const items = disciplines.flatMap((discipline) => {
	const section = sections.find(({ key }) => key === `capability-${discipline.key}`);
	return section ? [{ ...section, icon: discipline.icon, href: links[discipline.key], action: discipline[locale] }] : [];
});
---

{
	items.length > 0 && (
		<section id="capabilities" aria-labelledby="capabilities-title" class="capabilities py-section">
			<Container>
				<header class="capabilities-header">
					<p>{copy.label}</p>
					<Heading id="capabilities-title" level={2} class="capabilities-title">
						{copy.title}
					</Heading>
				</header>
				<ul class="capabilities-grid" role="list">
					{items.map((item) => (
						<li class="capability-card">
							<div class="capability-visual" aria-hidden="true">
								<span>
									<Icon name={item.icon} size={32} />
								</span>
							</div>
							<div class="capability-content">
								<Heading level={3} class="capability-title">
									{item.title}
								</Heading>
								<p>{item.body}</p>
								{item.href && (
									<a class="capability-link" href={item.href}>
										{item.action}
										<Icon name="lucide:arrow-right" size={17} class="shrink-0 rtl:rotate-180" aria-hidden="true" />
									</a>
								)}
							</div>
						</li>
					))}
				</ul>
			</Container>
		</section>
	)
}

<style>
	.capabilities {
		--capability-rule: var(--section-rule);
		border-block-start: 1px solid var(--capability-rule);
		background: var(--background);
	}

	.capabilities-header {
		display: grid;
		gap: 0.5rem;
		margin-block-end: clamp(1.5rem, 3vi, 2.5rem);
	}

	.capabilities-header p {
		color: var(--primary-link);
		font-size: 0.875rem;
		font-weight: 650;
	}

	.capabilities-header :global(.capabilities-title) {
		font-size: clamp(2rem, 1.35rem + 2.25vi, 3.35rem);
		line-height: 1.15;
		text-wrap: balance;
	}

	.capabilities-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: clamp(0.9rem, 2vi, 1.4rem);
	}

	.capability-card {
		display: flex;
		min-width: 0;
		flex-direction: column;
		overflow: clip;
		border: 1px solid var(--capability-rule);
		border-radius: 1rem;
		background: var(--brand-frame-surface);
	}

	.capability-visual {
		--grid: color-mix(in oklab, var(--primary-link) 11%, transparent);
		--grid-fade: to right;
		display: flex;
		align-items: center;
		min-height: 6.5rem;
		padding: 1.1rem clamp(1.15rem, 2.3vi, 1.75rem);
		border-block-end: 1px solid var(--capability-rule);
		background: linear-gradient(var(--grid-fade), transparent, var(--brand-frame-surface)), repeating-linear-gradient(90deg, transparent 0 23px, var(--grid) 23px 24px), repeating-linear-gradient(0deg, transparent 0 23px, var(--grid) 23px 24px), color-mix(in oklab, var(--primary-link) 10%, var(--brand-frame-surface));
	}

	.capability-visual:dir(rtl) {
		--grid-fade: to left;
	}

	.capability-visual span {
		display: grid;
		inline-size: 3.75rem;
		block-size: 3.75rem;
		place-items: center;
		border: 1px solid var(--capability-rule);
		border-radius: 0.8rem;
		background: var(--brand-frame-surface);
		color: var(--primary-link);
	}

	.capability-content {
		display: flex;
		flex: 1;
		flex-direction: column;
		align-items: start;
		gap: 0.65rem;
		padding: clamp(1.15rem, 2.3vi, 1.75rem);
	}

	.capability-content :global(.capability-title) {
		font-size: clamp(1.25rem, 1rem + 0.65vi, 1.55rem);
		line-height: 1.3;
	}

	.capability-content p {
		flex: 1;
		color: var(--muted-foreground);
		line-height: 1.7;
	}

	.capability-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		min-height: 2.75rem;
		color: var(--primary-link);
		font-size: 0.9375rem;
		font-weight: 650;
		text-underline-offset: 0.25em;
	}

	.capability-link:is(:hover, :focus-visible) {
		text-decoration: underline;
	}

	@media (min-width: 48rem) {
		.capabilities-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
</style>
