---
import type { CollectionEntry } from 'astro:content';
import Badge from '@/components/astro/content/Badge.astro';
import Breadcrumbs from '@/components/astro/content/Breadcrumbs.astro';
import CallToAction from '@/components/astro/content/CallToAction.astro';
import Card from '@/components/astro/content/Card.astro';
import Disclosure from '@/components/astro/content/Disclosure.astro';
import Grid from '@/components/astro/content/Grid.astro';
import Heading from '@/components/astro/content/Heading.astro';
import ProseText from '@/components/astro/content/ProseText.astro';
import Section from '@/components/astro/content/Section.astro';
import Stack from '@/components/astro/content/Stack.astro';
import TextLink from '@/components/astro/content/TextLink.astro';
import type { Locale } from '@/i18n/config';
import CommercialList from './CommercialList.astro';

type CommercialEntry = CollectionEntry<'products' | 'services' | 'solutions' | 'industries'>;

interface Link {
	href: string;
	label: string;
}

interface Props {
	locale: Locale;
	entry: CommercialEntry;
	breadcrumbs?: { label: string; href?: string }[];
	related?: readonly { title: string; description: string; href: string }[];
	cta?: Link;
	officialLink?: Link;
}

const { locale, entry, breadcrumbs = [], related = [], cta, officialLink } = Astro.props;
const { title, description, media } = entry.data;
const gallery = media.map((asset) => {
	const sources = new Map(asset.variants?.map(({ path, width }) => [width, path]));
	if (sources.size === 0) return { ...asset, srcset: undefined };
	if (asset.width) sources.set(asset.width, asset.path);
	const srcset = Array.from(sources, ([width, path]) => `${path} ${width}w`).join(', ');
	return { ...asset, srcset };
});
const product = entry.collection === 'products' ? entry.data : undefined;
const service = entry.collection === 'services' ? entry.data : undefined;
const solution = entry.collection === 'solutions' ? entry.data : undefined;
const industry = entry.collection === 'industries' ? entry.data : undefined;
const faq = product?.faq ?? service?.faq ?? [];
const copy = {
	ar: {
		breadcrumbs: 'مسار التنقّل',
		features: 'الإمكانات',
		platforms: 'المنصات',
		usage: 'حالات الاستخدام',
		media: 'معرض الصور',
		scope: 'نطاق الخدمة',
		deliverables: 'المخرجات',
		problem: 'التحدّي',
		needs: 'الاحتياجات',
		limitations: 'القيود',
		faq: 'الأسئلة الشائعة',
		related: 'محتوى ذو صلة',
		externalLinks: 'روابط المنتج',
		released: 'متاح',
		conditional: 'متاح بشروط',
		roadmap: 'مخطط له',
	},
	en: {
		breadcrumbs: 'Breadcrumb',
		features: 'Capabilities',
		platforms: 'Platforms',
		usage: 'Use cases',
		media: 'Image gallery',
		scope: 'Service scope',
		deliverables: 'Deliverables',
		problem: 'Challenge',
		needs: 'Needs',
		limitations: 'Limitations',
		faq: 'Frequently asked questions',
		related: 'Related content',
		externalLinks: 'Product links',
		released: 'Available',
		conditional: 'Conditionally available',
		roadmap: 'Planned',
	},
}[locale];
const focus = 'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-link';
---

<Section labelledBy="commercial-heading" tone="muted">
	<Stack>
		{breadcrumbs.length > 0 && <Breadcrumbs items={breadcrumbs} label={copy.breadcrumbs} />}
		<Heading id="commercial-heading" size="display">{title}</Heading>
		{
			product && (
				<div class="flex flex-wrap items-center gap-3">
					{product.brand && <bdi class="font-medium wrap-anywhere">{product.brand}</bdi>}
					<Badge variant={product.availability === 'released' ? 'secondary' : 'outline'}>{copy[product.availability]}</Badge>
				</div>
			)
		}
		<ProseText>{description}</ProseText>
		{
			(cta || officialLink) && (
				<div class="flex flex-wrap gap-3">
					{cta && <CallToAction {...cta} analyticsAction={product?.translationKey === 'bim' ? 'demo_cta' : 'consultation_cta'} />}
					{officialLink && <CallToAction {...officialLink} variant={cta ? 'outline' : 'default'} external {...(product?.translationKey === 'bim' ? { analyticsAction: 'bim_outbound' as const } : {})} />}
				</div>
			)
		}
	</Stack>
</Section>

{
	solution && (
		<Section labelledBy="commercial-challenge">
			<Stack>
				<Heading id="commercial-challenge" level={2} class="text-2xl">
					{copy.problem}
				</Heading>
				<ProseText>{solution.problem}</ProseText>
			</Stack>
		</Section>
	)
}

{
	product && (
		<Section labelledBy="commercial-features">
			<Stack>
				<Heading id="commercial-features" level={2} class="text-2xl">
					{copy.features}
				</Heading>
				<Grid as="ul">
					{product.features.map((feature) => (
						<li class="min-w-0">
							<Card class="h-full">
								<Stack spacing="compact">
									<Heading level={3} class="text-xl wrap-anywhere">
										{feature.title}
									</Heading>
									<div>
										<Badge variant={feature.availability === 'released' ? 'secondary' : 'outline'}>{copy[feature.availability]}</Badge>
									</div>
									<ProseText>{feature.description}</ProseText>
								</Stack>
							</Card>
						</li>
					))}
				</Grid>
			</Stack>
		</Section>
	)
}

{
	product?.platforms && product.platforms.length > 0 && (
		<Section labelledBy="commercial-platforms" tone="muted">
			<Stack>
				<Heading id="commercial-platforms" level={2} class="text-2xl">
					{copy.platforms}
				</Heading>
				<ul class="grid gap-3" role="list">
					{product.platforms.map((platform) => (
						<li class="flex min-w-0 flex-wrap items-center gap-3">
							{platform.url && platform.availability === 'released' ? (
								<TextLink href={platform.url} class={focus}>
									<bdi class="wrap-anywhere">{platform.name}</bdi>
								</TextLink>
							) : (
								<bdi class="wrap-anywhere">{platform.name}</bdi>
							)}
							<Badge variant={platform.availability === 'released' ? 'secondary' : 'outline'}>{copy[platform.availability]}</Badge>
						</li>
					))}
				</ul>
			</Stack>
		</Section>
	)
}

{product?.useCases && <CommercialList id="commercial-usage" title={copy.usage} items={product.useCases} />}
{service && <CommercialList id="commercial-scope" title={copy.scope} items={service.scope} />}
{service && <CommercialList id="commercial-deliverables" title={copy.deliverables} items={service.deliverables} />}
{industry && <CommercialList id="commercial-needs" title={copy.needs} items={industry.needs} />}
{industry && <CommercialList id="commercial-limitations" title={copy.limitations} items={industry.limitations} />}

{
	entry.data.sections?.map((item, index) => (
		<Section labelledBy={`commercial-section-${index}`}>
			<Stack>
				<Heading id={`commercial-section-${index}`} level={2} class="text-2xl wrap-anywhere">
					{item.title}
				</Heading>
				<ProseText class="whitespace-pre-line">{item.body}</ProseText>
			</Stack>
		</Section>
	))
}

{
	product?.externalLinks && product.externalLinks.length > 0 && (
		<Section labelledBy="commercial-external-links">
			<Stack>
				<Heading id="commercial-external-links" level={2} class="text-2xl">
					{copy.externalLinks}
				</Heading>
				<ul class="flex flex-wrap gap-4">
					{product.externalLinks.map(({ label, href }) => (
						<li>
							<TextLink {href} class={focus}>
								{label}
							</TextLink>
						</li>
					))}
				</ul>
			</Stack>
		</Section>
	)
}

{
	gallery.length > 0 && (
		<Section labelledBy="commercial-media" tone="muted">
			<Stack>
				<Heading id="commercial-media" level={2} class="text-2xl">
					{copy.media}
				</Heading>
				<Grid as="ul" columns={2}>
					{gallery.map((asset) => (
						<li class="min-w-0">
							<figure class="space-y-3">
								<img src={asset.path} srcset={asset.srcset} sizes={asset.srcset ? '(min-width: 90rem) 42rem, (min-width: 48rem) calc(50vw - 3rem), calc(100vw - 2rem)' : undefined} alt={asset.alt} width={asset.width} height={asset.height} loading="lazy" decoding="async" class="h-auto w-full rounded-xl border bg-card" />
								{asset.caption && <figcaption class="text-sm wrap-anywhere text-muted-foreground">{asset.caption}</figcaption>}
							</figure>
						</li>
					))}
				</Grid>
			</Stack>
		</Section>
	)
}

{
	faq.length > 0 && (
		<Section labelledBy="commercial-faq">
			<Stack>
				<Heading id="commercial-faq" level={2} class="text-2xl">
					{copy.faq}
				</Heading>
				{faq.map(({ question, answer }) => (
					<Disclosure label={question}>
						<ProseText>{answer}</ProseText>
					</Disclosure>
				))}
			</Stack>
		</Section>
	)
}

{
	related.length > 0 && (
		<Section labelledBy="commercial-related">
			<Stack>
				<Heading id="commercial-related" level={2} class="text-2xl">
					{copy.related}
				</Heading>
				<Grid as="ul">
					{related.map((item) => (
						<li class="min-w-0">
							<Card class="h-full">
								<Stack>
									<Heading level={3} class="text-xl wrap-anywhere">
										<TextLink href={item.href} class={focus}>
											{item.title}
										</TextLink>
									</Heading>
									<ProseText>{item.description}</ProseText>
								</Stack>
							</Card>
						</li>
					))}
				</Grid>
			</Stack>
		</Section>
	)
}
