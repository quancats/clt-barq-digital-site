---
import { cn } from '@/lib/utils';
import { cardVariants, type CardVariants } from '@/lib/ui/astroVariants';

type CardTag = 'article' | 'div' | 'section';

interface Props {
	as?: CardTag;
	padding?: CardVariants['padding'];
	class?: string;
}

const props = Astro.props as Props;
const tag: CardTag = props.as ?? 'div';
const padding = props.padding ?? 'default';
const className = props.class;
const classes = cn(cardVariants({ padding }), className);
---

{
	tag === 'article' ? (
		<article class={classes}>
			<slot />
		</article>
	) : tag === 'section' ? (
		<section class={classes}>
			<slot />
		</section>
	) : (
		<div class={classes}>
			<slot />
		</div>
	)
}
