---
interface Props {
	level?: 1 | 2 | 3 | 4 | 5 | 6;
	id?: string;
	class?: string;
	size?: 'default' | 'display';
}

const { level = 1, id, class: className = '', size = 'default' } = Astro.props;
const Tag = `h${level}` as const;
---

<Tag id={id} class:list={['font-bold tracking-tight text-foreground', size === 'display' && 'text-display wrap-anywhere', className]}>
	<slot />
</Tag>
