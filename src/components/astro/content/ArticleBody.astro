---
import { formatDate } from '@/i18n/format';
import type { Locale } from '@/i18n/config';
import PageHeading from './PageHeading.astro';

interface Props {
	locale: Locale;
	title: string;
	description: string;
	publishedAt?: Date | undefined;
}

const { locale, title, description, publishedAt } = Astro.props;
---

<div class="mb-8 border-b border-border pb-6">
	<PageHeading {title} {description} embedded>
		{
			publishedAt && (
				<p class="text-sm text-muted-foreground">
					<time datetime={publishedAt.toISOString()}>{formatDate(locale, publishedAt)}</time>
				</p>
			)
		}
	</PageHeading>
</div>
<div class="prose">
	<slot />
</div>
