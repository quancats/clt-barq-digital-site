---
import { formatDate } from '@/i18n/format';
import type { Locale } from '@/i18n/config';

interface Props {
	locale: Locale;
	title: string;
	description: string;
	publishedAt: Date;
}

const { locale, title, description, publishedAt } = Astro.props;
---

<header class="mb-8 border-b border-border pb-6 wrap-anywhere">
	<h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{title}</h1>
	<p class="mt-3 text-muted-foreground">{description}</p>
	<p class="mt-4 text-sm text-muted-foreground">
		<time datetime={publishedAt.toISOString()}>{formatDate(locale, publishedAt)}</time>
	</p>
</header>
<div class="prose">
	<slot />
</div>
