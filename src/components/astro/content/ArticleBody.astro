---
interface Props {
	title: string;
	description: string;
	publishedAt: Date;
}

const { title, description, publishedAt } = Astro.props;
---

<header class="mb-8 border-b border-border pb-6 wrap-anywhere">
	<h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{title}</h1>
	<p class="mt-3 text-muted-foreground">{description}</p>
	<p class="mt-4 text-sm text-muted-foreground">
		<time datetime={publishedAt.toISOString()}>{publishedAt.toISOString().slice(0, 10)}</time>
	</p>
</header>
<div class="prose">
	<slot />
</div>
