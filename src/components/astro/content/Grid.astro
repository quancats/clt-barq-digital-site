---
import { cn } from '@/lib/utils';

interface Props {
	as?: 'div' | 'ul';
	columns?: 2 | 3 | 4;
	class?: string;
}

const { as: Tag = 'div', columns = 3, class: className } = Astro.props;
const columnClasses = {
	2: 'md:grid-cols-2',
	3: 'sm:grid-cols-2 lg:grid-cols-3',
	4: 'sm:grid-cols-2 lg:grid-cols-4',
};
---

<Tag role={Tag === 'ul' ? 'list' : undefined} class={cn('grid min-w-0 grid-cols-1 gap-grid-gutter', columnClasses[columns], className)}>
	<slot />
</Tag>
