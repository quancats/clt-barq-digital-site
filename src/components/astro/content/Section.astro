---
import { cn } from '@/lib/utils';

interface Props {
	id?: string;
	labelledBy?: string;
	tone?: 'plain' | 'muted';
	class?: string;
}

const { id, labelledBy, tone = 'plain', class: className } = Astro.props;
---

<section {id} aria-labelledby={labelledBy} class={cn('py-section', tone === 'muted' && 'bg-muted text-foreground', className)}>
	<div class="mx-auto w-full max-w-editorial px-grid-gutter">
		<slot />
	</div>
</section>
