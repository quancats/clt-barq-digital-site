---
import { cn } from '@/lib/utils';
import { badgeVariants, type BadgeVariants } from '@/lib/ui/astroVariants';

interface Props {
	variant?: BadgeVariants['variant'];
	class?: string;
}

const { variant = 'secondary', class: className } = Astro.props;
---

<span class={cn(badgeVariants({ variant }), className)}>
	<slot />
</span>
