---
interface Props {
	jsonLd?: Record<string, unknown> | Record<string, unknown>[] | undefined;
}

const { jsonLd } = Astro.props;
const payload = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

{payload.map((entry) => <script is:inline type="application/ld+json" set:html={JSON.stringify(entry)} />)}
