---
import { cn } from '@/lib/utils';

interface Props {
	label: string;
	name: string;
	hint?: string | undefined;
	error?: string | undefined;
	required?: boolean | undefined;
	class?: string | undefined;
}

const { label, name, hint, error, required = false, class: className } = Astro.props;
const hintId = `${name}-hint`;
const errorId = `${name}-error`;
const describedBy = [error ? errorId : undefined, hint && !error ? hintId : undefined].filter(Boolean).join(' ') || undefined;
const hasControlSlot = Astro.slots.has('control');
---

<div class={cn('space-y-2', className)}>
	<label for={name} class="block text-sm font-medium text-foreground">
		{label}
		{
			required ? (
				<span class="text-destructive" aria-hidden="true">
					*
				</span>
			) : null
		}
	</label>
	{hasControlSlot ? <slot name="control" id={name} aria-describedby={describedBy} aria-invalid={error ? 'true' : undefined} aria-required={required ? 'true' : undefined} /> : <slot />}
	{
		hint && !error ? (
			<p id={hintId} class="text-sm text-muted-foreground">
				{hint}
			</p>
		) : null
	}
	{
		error ? (
			<p id={errorId} class="text-sm text-destructive" role="alert">
				{error}
			</p>
		) : null
	}
</div>
