---
import HeaderChrome from '@/components/islands/interactive/HeaderChrome.vue';
import Container from '@/components/layout/Container.astro';
import NativeThemePicker from '@/components/layout/NativeThemePicker.astro';
import brandLogo from '@/assets/images/brand/logo.png';
import { getImage } from 'astro:assets';
import { primaryNavPaths } from '@/data/navigation';
import { localizePath, type Locale } from '@/i18n/config';
import { getDictionary } from '@/i18n/helpers';
import { getRouteAvailability } from '@/lib/navigation/getRouteAvailability';
import { getSiteSections } from '@/lib/content/queries/getSiteRoutes';
import { cn } from '@/lib/utils';
import { resolveStoredTheme } from '@/scripts/theme';
import { PUBLIC_DEFAULT_THEME } from 'astro:env/client';

interface Props {
	locale: Locale;
	alternatePath?: string | undefined;
	class?: string | undefined;
}

const { locale, alternatePath, class: className } = Astro.props;
const dictionary = getDictionary(locale);
const logoWidth = 56;
const logo = await getImage({ src: brandLogo, width: logoWidth * 2 });
const brand = { src: logo.src, width: logoWidth, height: Math.round((brandLogo.height / brandLogo.width) * logoWidth), label: dictionary.common.brand };
const availability = await getRouteAvailability(locale);
const siteLinks = (await getSiteSections(locale)).filter(({ key }) => ['about', 'products', 'services', 'solutions', 'industries', 'projects', 'contact'].includes(key)).map(({ href, title }) => ({ href, title }));
const homeHref = localizePath(locale, primaryNavPaths.home);
const articlesHref = localizePath(locale, primaryNavPaths.articles);
const componentsHref = localizePath(locale, primaryNavPaths.components);
const otherLocale: Locale = locale === 'ar' ? 'en' : 'ar';
const defaultTheme = resolveStoredTheme(PUBLIC_DEFAULT_THEME);

const chromeCopy = {
	navLabel: dictionary.layout.nav_label,
	navMobileLabel: dictionary.layout.nav_mobile_label,
	navMenu: dictionary.layout.nav_menu,
	navHome: dictionary.layout.nav_home,
	navExplore: dictionary.layout.nav_explore,
	navArticles: dictionary.layout.nav_articles,
	navComponents: dictionary.layout.nav_components,
	switchLanguage: dictionary.common.switch_language,
	translationUnavailable: dictionary.common.translation_unavailable,
	languageNameAr: dictionary.common.language_name_ar,
	languageNameEn: dictionary.common.language_name_en,
	themeLabel: dictionary.common.theme_label,
	themeLight: dictionary.common.theme_light,
	themeDark: dictionary.common.theme_dark,
	themeAuto: dictionary.common.theme_auto,
	ctaLabel: dictionary.layout.header_cta,
	close: dictionary.common.close,
} as const;

const chromePaths = {
	home: homeHref,
	articles: availability.articles ? articlesHref : undefined,
	components: availability.preview ? componentsHref : undefined,
	alternateHref: alternatePath,
	siteLinks,
} as const;

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

function isCurrentPath(href: string): boolean {
	const normalized = href.replace(/\/$/, '') || '/';
	return currentPath === normalized;
}
---

<header class={cn('sticky top-0 z-50 border-b border-border bg-card', className)}>
	<Container class="py-4">
		{availability.preview && <HeaderChrome client:load locale={locale} defaultTheme={defaultTheme} {brand} copy={chromeCopy} paths={chromePaths} currentPath={currentPath} />}
		<div data-header-fallback>
			<div class="flex flex-wrap items-center justify-between gap-3 text-sm font-medium">
				<nav aria-label={dictionary.layout.nav_label} class="flex flex-wrap items-center gap-x-3">
					<a class="inline-flex min-h-11 items-center gap-2 wrap-anywhere underline focus-visible:outline-2" href={homeHref} data-astro-prefetch aria-current={isCurrentPath(homeHref) ? 'page' : undefined}>
						<img src={brand.src} alt="" width={brand.width} height={brand.height} />
						<span class="sr-only">{dictionary.layout.nav_home}</span>
					</a>
					{
						siteLinks.map(({ href, title }) => (
							<a class="inline-flex min-h-11 items-center wrap-anywhere underline focus-visible:outline-2" {href} data-astro-prefetch aria-current={isCurrentPath(href) ? 'page' : undefined}>
								{title}
							</a>
						))
					}
					{
						availability.articles && (
							<a class="inline-flex min-h-11 items-center wrap-anywhere underline focus-visible:outline-2" href={articlesHref} data-astro-prefetch aria-current={isCurrentPath(articlesHref) ? 'page' : undefined}>
								{dictionary.layout.nav_articles}
							</a>
						)
					}
					{
						availability.preview && (
							<a class="inline-flex min-h-11 items-center wrap-anywhere underline focus-visible:outline-2" href={componentsHref} data-astro-prefetch aria-current={isCurrentPath(componentsHref) ? 'page' : undefined}>
								{dictionary.layout.nav_components}
							</a>
						)
					}
				</nav>
				{
					alternatePath ? (
						<nav aria-label={dictionary.common.switch_language}>
							<a class="inline-flex min-h-11 items-center wrap-anywhere underline focus-visible:outline-2" href={alternatePath} hreflang={otherLocale} lang={otherLocale}>
								{otherLocale === 'ar' ? dictionary.common.language_name_ar : dictionary.common.language_name_en}
							</a>
						</nav>
					) : (
						<span class="text-muted-foreground">{dictionary.common.translation_unavailable}</span>
					)
				}
				{!availability.preview && <NativeThemePicker {locale} />}
			</div>
		</div>
	</Container>
</header>

<style>
	:global(astro-island[ssr] [data-header-chrome]),
	:global(astro-island:not([ssr])) + [data-header-fallback] {
		display: none;
	}
</style>
