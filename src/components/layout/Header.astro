---
import { getImage, Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { PUBLIC_DEFAULT_THEME } from 'astro:env/client';
import arabicLogo from '@/assets/images/brand/logo.png';
import englishLogo from '@/assets/images/brand/logo-en.png';
import HeaderChrome from '@/components/islands/interactive/HeaderChrome.vue';
import Container from '@/components/layout/Container.astro';
import { localizePath, type Locale } from '@/i18n/config';
import { getDictionary } from '@/i18n/helpers';
import { commercialFamilies, getSiteContent } from '@/lib/content/queries/getSiteRoutes';
import { getCorporateNavigation } from '@/lib/navigation/getCorporateNavigation';
import { cn } from '@/lib/utils';
import { resolveStoredTheme } from '@/scripts/theme';

interface Props {
	locale: Locale;
	alternatePath?: string | undefined;
	class?: string | undefined;
}

const { locale, alternatePath, class: className } = Astro.props;
const { common, layout } = getDictionary(locale);
const brandLogo = locale === 'en' ? englishLogo : arabicLogo;
const brandWidth = locale === 'en' ? 64 : 56;
const [{ home, contact, groups }, content, logo] = await Promise.all([getCorporateNavigation(locale), getSiteContent(), getImage({ src: brandLogo, width: brandWidth * 2 })]);
const otherLocale = locale === 'ar' ? 'en' : 'ar';
const normalize = (path: string) => path.replace(/\/$/, '') || '/';
const currentPath = normalize(Astro.url.pathname);
const isCurrent = (href: string) => normalize(href) === currentPath;
const isSection = (href: string) => isCurrent(href) || currentPath.startsWith(normalize(href) + '/');
const [company, capabilities, knowledge, inquiries] = groups;
const request = inquiries?.links.find(({ key }) => key === 'consultation') ?? contact;
const serviceRequest = request ? { ...request, title: locale === 'ar' ? 'اطلب خدمة' : 'Request a service' } : undefined;
const demo = inquiries?.links.find(({ key }) => key === 'demo');
const commercialMenus = ['services', 'solutions', 'products', 'industries'].flatMap((key) => {
	const section = capabilities?.links.find((link) => link.key === key);
	const family = commercialFamilies.find((family) => family === key);
	if (!section || !family) return [];
	const entries = content[family]
		.filter(({ data }) => data.locale === locale)
		.map(({ data }) => ({
			href: localizePath(locale, `${family}/${data.slug}`),
			title: family === 'products' && data.translationKey === 'bim' ? (locale === 'ar' ? 'منصة BIM للتواصل المؤسسي' : 'BIM enterprise communications') : data.title,
		}));
	return [{ key, title: section.title, overview: section, links: [section, ...entries, ...(family === 'products' && demo ? [demo] : [])] }];
});
const menus = [...commercialMenus, ...(company ? [{ key: 'company', ...company }] : []), ...(knowledge ? [{ key: 'knowledge', ...knowledge }] : []), ...(contact ? [{ key: 'contact', title: contact.title, links: [contact] }] : [])].filter(({ links }) => links.length);
const brand = { src: logo.src, width: brandWidth, height: Math.round((brandLogo.height / brandLogo.width) * brandWidth), label: common.brand };
---

<header class={cn('sticky top-0 z-50 border-b border-border bg-card', className)}>
	<script is:inline>
		(() => {
			const header = document.currentScript?.parentElement;
			if (!header) return;
			header.setAttribute('data-header-booting', '');
			const finish = () => {
				header.removeAttribute('data-header-booting');
				window.clearTimeout(timeout);
			};
			const timeout = window.setTimeout(finish, 6000);
			header.addEventListener('astro:hydrate', finish, { capture: true, once: true });
		})();
	</script>
	<HeaderChrome client:load {locale} {brand} {home} {serviceRequest} {menus} {alternatePath} {currentPath} defaultTheme={resolveStoredTheme(PUBLIC_DEFAULT_THEME)} {common} {layout} />
	<div data-header-fallback>
		<Container class="header-row">
			<a href={home.href} aria-current={isCurrent(home.href) ? 'page' : undefined} class="brand">
				<Image src={brandLogo} alt={common.brand} width={brandWidth} densities={[1, 2]} />
			</a>

			<nav aria-label={layout.nav_label} class="navigation">
				<button class="menu-toggle nav-link" type="button" aria-expanded="false" aria-controls="corporate-navigation" hidden>
					<Icon name="lucide:menu" size={20} aria-hidden="true" />
					{layout.nav_menu}
				</button>
				<ul id="corporate-navigation" class="nav-list">
					<li>
						<a href={home.href} class="nav-link" aria-current={isCurrent(home.href) ? 'page' : undefined}>{home.title}</a>
					</li>
					{
						menus.map(({ title, links }) => (
							<li>
								{links.length === 1 && links[0] ? (
									<a href={links[0].href} class="nav-link" aria-current={isCurrent(links[0].href) ? 'page' : undefined}>
										{title}
									</a>
								) : (
									<details class="nav-group">
										<summary class:list={['nav-link', { 'active-group': links.some(({ href }) => isSection(href)) }]}>
											{title}
											<Icon name="lucide:chevron-down" size={16} aria-hidden="true" />
										</summary>
										<ul class="dropdown">
											{links.map(({ href, title }) => (
												<li>
													<a {href} class="nav-link" aria-current={isCurrent(href) ? 'page' : undefined}>
														{title}
													</a>
												</li>
											))}
										</ul>
									</details>
								)}
							</li>
						))
					}
				</ul>
			</nav>

			<div class="header-actions">
				{
					alternatePath ? (
						<a href={alternatePath} class="nav-link" hreflang={otherLocale} lang={otherLocale} aria-label={common.switch_language}>
							<Icon name="lucide:languages" size={16} aria-hidden="true" />
						</a>
					) : (
						<span class="sr-only">{common.translation_unavailable}</span>
					)
				}
				{
					serviceRequest && (
						<a href={serviceRequest.href} class="brand-request-action contact-link" aria-current={isCurrent(serviceRequest.href) ? 'page' : undefined}>
							{serviceRequest.title}
						</a>
					)
				}
			</div>
		</Container>
	</div>
</header>

<script>
	const nav = document.querySelector<HTMLElement>('.navigation');
	const toggle = nav?.querySelector<HTMLButtonElement>('.menu-toggle');
	const groups = nav?.querySelectorAll<HTMLDetailsElement>('.nav-group');

	if (nav && toggle) {
		toggle.hidden = false;
		nav.classList.add('enhanced');

		toggle.addEventListener('click', () => {
			const expanded = toggle.getAttribute('aria-expanded') === 'true';
			toggle.setAttribute('aria-expanded', String(!expanded));
			if (expanded)
				groups?.forEach((group) => {
					group.open = false;
				});
		});

		document.addEventListener('click', (event) => {
			if (!(event.target instanceof Node)) return;
			const target = event.target;
			groups?.forEach((group) => {
				if (!group.contains(target)) group.open = false;
			});
			if (!nav.contains(target)) toggle.setAttribute('aria-expanded', 'false');
		});

		nav.addEventListener('keydown', (event) => {
			if (!(event instanceof KeyboardEvent) || event.key !== 'Escape' || !(event.target instanceof Element)) return;
			const group = event.target.closest<HTMLDetailsElement>('details[open]');
			if (group) {
				group.open = false;
				group.querySelector('summary')?.focus();
			} else if (toggle.getAttribute('aria-expanded') === 'true') {
				toggle.setAttribute('aria-expanded', 'false');
				toggle.focus();
			}
		});
	}
</script>

<style>
	header:not([data-header-booting]) :global(astro-island[ssr] [data-header-chrome]),
	header[data-header-booting] > [data-header-fallback],
	:global(astro-island:not([ssr])) + [data-header-fallback] {
		display: none;
	}
	[data-header-fallback] > :global(.header-row) {
		display: flex;
		min-height: 5rem;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 1.25rem;
		padding-block: 0.65rem;
	}
	.brand,
	.header-actions,
	.nav-list {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}
	.brand {
		font-weight: 700;
		white-space: nowrap;
	}
	.brand img {
		flex: none;
	}
	.nav-link,
	.contact-link {
		display: flex;
		min-height: 2.75rem;
		align-items: center;
		gap: 0.4rem;
		padding-inline: 0.7rem;
		border-radius: var(--radius-md);
		font-size: 0.875rem;
		font-weight: 600;
	}
	.nav-link:is(:hover, :focus-visible, [aria-current]),
	.active-group,
	.nav-group[open] > summary {
		background: var(--accent);
		color: var(--accent-foreground);
	}
	summary {
		cursor: pointer;
		list-style: none;
	}
	summary::-webkit-details-marker {
		display: none;
	}
	.nav-group {
		position: relative;
	}
	.dropdown {
		position: absolute;
		inset-block-start: 100%;
		inset-inline-start: 0;
		width: max-content;
		min-width: 12rem;
		max-width: min(20rem, 80vw);
		padding: 0.35rem;
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		background: var(--card);
		box-shadow: 0 12px 26px rgb(0 0 0 / 0.12);
	}
	.contact-link {
		padding-inline: 1rem;
		white-space: nowrap;
	}
	.menu-toggle {
		display: none;
	}
	@media (width < 70rem) {
		[data-header-fallback] > :global(.header-row) {
			flex-wrap: wrap;
		}
		.navigation {
			order: 3;
			width: 100%;
		}
		.nav-list {
			align-items: stretch;
			flex-direction: column;
		}
		.enhanced .menu-toggle {
			display: flex;
		}
		.enhanced .menu-toggle[aria-expanded='false'] + .nav-list {
			display: none;
		}
		.enhanced .nav-list {
			position: absolute;
			inset-block-start: 100%;
			inset-inline: 0;
			max-height: 54dvh;
			overflow-y: auto;
			padding: 0.5rem 1rem;
			border-block-end: 1px solid var(--border);
			background: var(--card);
			box-shadow: 0 12px 26px rgb(0 0 0 / 0.12);
		}
		.dropdown {
			position: static;
			width: auto;
			max-width: none;
			margin-inline-start: 0.75rem;
			box-shadow: none;
		}
	}
	@media (max-width: 30rem) {
		[data-header-fallback] > :global(.header-row) {
			gap: 0.25rem 0.5rem;
		}
		[data-header-fallback] > :global(.header-row):has(.enhanced) {
			display: grid;
			grid-template-columns: 1fr auto;
		}
		.enhanced {
			grid-column: 2;
			grid-row: 1;
			width: auto;
		}
		.header-actions {
			flex-wrap: wrap;
		}
		[data-header-fallback] > :global(.header-row):has(.enhanced) .header-actions {
			grid-column: 1 / -1;
			grid-row: 2;
		}
	}
</style>
