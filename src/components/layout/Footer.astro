---
import { Icon } from 'astro-icon/components';
import Container from '@/components/layout/Container.astro';
import { socialLinks } from '@/data/social';
import { localizePath, type Locale } from '@/i18n/config';
import { getDictionary } from '@/i18n/helpers';
import { parseAnalyticsMode, shouldShowAnalyticsPreferenceUi } from '@/lib/analytics/consent';
import { isGoogleAnalyticsEnabled } from '@/lib/analytics/googleAnalytics';
import { PRIMARY_NAV_PREFETCH_ATTRS } from '@/lib/navigation/prefetch';
import { cn } from '@/lib/utils';
import { PUBLIC_GOOGLE_ANALYTICS_ENABLED, PUBLIC_GOOGLE_ANALYTICS_MODE } from 'astro:env/client';

interface Props {
	locale: Locale;
	class?: string | undefined;
}

const { locale, class: className } = Astro.props;
const dictionary = getDictionary(locale);
const year = new Date().getFullYear();
const homeHref = localizePath(locale, '/');
const social = dictionary.layout.footer_social;
const copyright = dictionary.layout.footer_copyright.replace('{year}', String(year)).replace('{brand}', dictionary.common.brand);
const analyticsMode = parseAnalyticsMode(PUBLIC_GOOGLE_ANALYTICS_MODE);
const showPrivacySettings = shouldShowAnalyticsPreferenceUi({
	mode: analyticsMode,
	analyticsEnabled: isGoogleAnalyticsEnabled(PUBLIC_GOOGLE_ANALYTICS_ENABLED),
});

function resolveFooterHref(path: string): string {
	if (path === '#' || path.startsWith('http://') || path.startsWith('https://')) {
		return path;
	}
	return localizePath(locale, path);
}
---

<footer class={cn('border-t border-border bg-card', className)}>
	<Container class="py-12 lg:py-16">
		<div class="space-y-12">
			<div class="max-w-sm space-y-4">
				<a href={homeHref} class="inline-flex items-center text-primary transition-opacity hover:opacity-80" {...PRIMARY_NAV_PREFETCH_ATTRS}>
					<Icon name="simple-icons:astro" size={28} aria-hidden="true" />
					<span class="sr-only">{dictionary.common.brand}</span>
				</a>
				<p class="text-sm leading-relaxed text-muted-foreground">
					{dictionary.layout.footer_note}
				</p>
				<ul class="flex flex-wrap items-center gap-5" aria-label={dictionary.layout.footer_social_label}>
					{
						socialLinks.map((link, index) => (
							<li>
								<a href={social[index]?.href ?? link.href} class="inline-flex size-11 items-center justify-center rounded-sm text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-2" aria-label={social[index]?.label ?? link.label}>
									<Icon name={link.icon} size={20} aria-hidden="true" />
								</a>
							</li>
						))
					}
				</ul>
			</div>

			<nav aria-label={dictionary.layout.footer_nav_label} class="grid grid-cols-2 gap-4 wrap-anywhere sm:grid-cols-4 sm:gap-8">
				{
					dictionary.layout.footer_columns.map((column) => (
						<div>
							<h2 class="text-sm font-semibold text-foreground">{column.title}</h2>
							<ul class="mt-2">
								{column.links.map((link) => (
									<li>
										<a href={resolveFooterHref(link.path)} class="flex min-h-11 items-center rounded-sm text-sm text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-2">
											{link.label}
										</a>
									</li>
								))}
							</ul>
						</div>
					))
				}
			</nav>
		</div>

		<div class="mt-12 flex flex-col gap-3 border-t border-border pt-8 sm:flex-row sm:items-center sm:justify-between">
			<p class="text-sm text-muted-foreground">{copyright}</p>
			<div class="flex flex-col gap-2 sm:items-end">
				{
					showPrivacySettings ? (
						<button type="button" class="inline-flex min-h-11 items-center justify-center self-start rounded-lg px-2 text-sm font-medium text-muted-foreground underline-offset-4 transition-colors hover:text-foreground hover:underline sm:self-end" data-privacy-settings>
							{dictionary.common.cookie_consent.privacy_settings}
						</button>
					) : null
				}
				<p class="text-sm text-muted-foreground">
					{dictionary.layout.footer_made_with}{' '}
					<a href="https://quancats.com" class="font-medium text-brand-800 underline-offset-4 hover:underline dark:text-brand-300" rel="noopener noreferrer" target="_blank">
						{dictionary.layout.footer_made_with_brand}
					</a>
				</p>
			</div>
		</div>
	</Container>
</footer>
