# Project work environment (Astro env.schema → import { ENV } from 'astro:env/server').
# Allowed values: local | staging | production
# Classification: public / server (build-time and prerender)
# Use production only for real public deploys. Local/CI should stay local (or staging).
ENV=local

# Public previews let crawlers read noindex. Private previews also require host authentication.
PREVIEW_CRAWL_POLICY=public

# Public production site origin used for canonical URLs, sitemap, robots.txt, and RSS.
# Must be an absolute http(s) origin. Real deployments must replace example.com.
# Local/CI may use https://example.com. Production builds fail with an unset or invalid origin.
# Classification: public / server (also resolved in astro.config via loadEnv for Astro `site`)
# Import: import { PUBLIC_SITE_URL } from 'astro:env/server'
PUBLIC_SITE_URL=https://example.com

# Default color mode before the visitor chooses a preference.
# Allowed values: light | dark | auto
# Classification: public / client
# Falls back to "auto" from astro.config.ts env.schema when unset.
PUBLIC_DEFAULT_THEME=auto

# Google Analytics 4 Measurement ID (format: G-XXXXXXXX).
# Classification: public / client
# In production, GA4 is eligible when this ID is valid, PUBLIC_GOOGLE_ANALYTICS_ENABLED is not false,
# and PUBLIC_GOOGLE_ANALYTICS_MODE is not "off", and (for default opt-in) stored preference is granted.
# Leave unset to skip GA injection; privacy settings remain available when analytics is enabled and mode is not off.
# Dev builds never inject GA.
# PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXX

# Explicit GA4 enable/disable switch (default: true).
# Classification: public / client
# Set to false to disable GA4 and hide analytics preference UI.
# PUBLIC_GOOGLE_ANALYTICS_ENABLED=true

# Analytics privacy mode (default: opt-in).
# Classification: public / client
# Allowed values:
#   off      — never inject GA; do not show analytics preference UI
#   opt-out  — GA may load when configured unless stored preference is denied (may load before first choice)
#   opt-in   — GA must not load until stored preference is granted (default)
# Migration: PUBLIC_ANALYTICS_CONSENT_REQUIRED was removed. Prefer PUBLIC_GOOGLE_ANALYTICS_MODE.
# PUBLIC_GOOGLE_ANALYTICS_MODE=opt-in

# Public Turnstile widget key. The Worker secret belongs in its environment.
# Forms require an approved same-language privacy notice and, for consultation, published services.
# PUBLIC_TURNSTILE_SITE_KEY=
