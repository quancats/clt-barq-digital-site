{
	"name": "astro-template",
	"type": "module",
	"version": "1.2.0",
	"engines": {
		"node": ">=24 <25"
	},
	"scripts": {
		"dev": "astro dev",
		"preview": "astro preview",
		"astro": "astro",
		"fix:format": "prettier . --write",
		"fix:lint": "eslint . --fix",
		"format": "npm run fix:format",
		"format:fix": "npm run fix:format",
		"lint:fix": "npm run fix:lint",
		"format:check": "prettier . --check",
		"lint": "eslint .",
		"check": "astro check",
		"typecheck:vue": "vue-tsc --noEmit -p tsconfig.vue.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"validate": "npm run format:check && npm run lint && npm run check && npm run typecheck:vue && npm test",
		"build": "astro build",
		"verify:budget": "node scripts/check-performance-budget.mjs",
		"verify:links": "node scripts/check-internal-links.mjs",
		"verify:seo": "node scripts/check-seo.mjs",
		"verify:e2e": "playwright test",
		"verify": "npm run verify:budget && npm run verify:links && npm run verify:seo && npm run verify:e2e",
		"test:budget": "npm run verify:budget",
		"test:links": "npm run verify:links",
		"test:e2e": "npm run verify:e2e",
		"ci:local": "npm run validate && npm run build && npm run verify"
	},
	"dependencies": {
		"@astrojs/mdx": "^8.1.6",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.6",
		"@astrojs/vue": "^7.1.6",
		"@iconify-json/lucide": "^1.2.157",
		"@iconify-json/simple-icons": "^1.2.103",
		"@lucide/vue": "^1.77.0",
		"@vueuse/core": "^14.4.0",
		"astro": "^7.4.13",
		"astro-icon": "^1.2.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"embla-carousel-vue": "^8.6.0",
		"entities": "^7.0.1",
		"reka-ui": "^2.11.0",
		"tailwind-merge": "^3.7.1",
		"tw-animate-css": "^1.4.0",
		"ultrahtml": "^1.6.0",
		"vee-validate": "^4.15.1",
		"vue": "^3.5.46",
		"vue-sonner": "^2.0.9"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"@axe-core/playwright": "^4.14.0",
		"@playwright/test": "^1.65.1",
		"@tailwindcss/vite": "^4.3.5",
		"@typescript-eslint/eslint-plugin": "^8.73.0",
		"@typescript-eslint/parser": "^8.73.0",
		"@vue/tsconfig": "^0.9.1",
		"eslint": "^10.15.0",
		"eslint-plugin-astro": "^1.7.0",
		"eslint-plugin-vue": "^10.12.1",
		"prettier": "^3.10.1",
		"prettier-plugin-astro": "^0.14.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"tailwindcss": "^4.3.5",
		"typescript": "^5.9.3",
		"vitest": "^4.1.12",
		"vue-tsc": "^3.3.14"
	}
}
